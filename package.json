{
  "name": "tessera-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "pnpm build && prettier --write .",
    "format:check": "pnpm build && prettier --check .",
    "docs:build": "pnpm --filter website build",
    "ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm docs:build",
    "build": "pnpm --filter @tessera/compiler build && pnpm --filter @tessera/editor build && pnpm --filter @tessera/cli build && pnpm --filter @pixelscriptio/tessera build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pixelscriptio/tessera": "workspace:*",
    "@tessera/a11y": "workspace:*",
    "@tessera/behavior": "workspace:*",
    "@tessera/cli": "workspace:*",
    "@tessera/compiler": "workspace:*",
    "@tessera/core": "workspace:*",
    "@tessera/editor": "workspace:*",
    "@tessera/router": "workspace:*",
    "@tessera/tokens": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/vscode": "^1.140.0",
    "@vitest/browser": "^3.2.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
