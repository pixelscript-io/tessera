{
  "color": {
    "$type": "color",
    "neutral": {
      "0": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1]
        }
      },
      "100": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.96078431, 0.96470588, 0.97254902]
        }
      },
      "200": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.88627451, 0.90980392, 0.94117647]
        }
      },
      "600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.27843137, 0.33333333, 0.41176471]
        }
      },
      "700": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2, 0.25490196, 0.33333333]
        }
      },
      "800": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.11764706, 0.16078431, 0.23137255]
        }
      },
      "900": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.06666667, 0.09411765, 0.15294118]
        }
      }
    },
    "blue": {
      "300": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.57647059, 0.77254902, 0.99215686]
        }
      },
      "400": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.37647059, 0.64705882, 0.98039216]
        }
      },
      "600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.14509804, 0.38823529, 0.92156863]
        }
      },
      "700": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.11372549, 0.30588235, 0.84705882]
        }
      }
    },
    "red": {
      "400": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.97254902, 0.44313725, 0.44313725]
        }
      },
      "500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9372549, 0.26666667, 0.26666667]
        }
      },
      "700": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7254902, 0.10980392, 0.10980392]
        }
      },
      "800": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6, 0.10588235, 0.10588235]
        }
      }
    },
    "surface": {
      "default": {
        "$value": "{color.neutral.0}",
        "$description": "Page background"
      },
      "raised": {
        "$value": "{color.neutral.100}"
      },
      "hover": {
        "$value": "{color.neutral.200}"
      }
    },
    "text": {
      "default": {
        "$value": "{color.neutral.900}",
        "$description": "Body text"
      },
      "muted": {
        "$value": "{color.neutral.700}"
      }
    },
    "action": {
      "primary": {
        "bg": {
          "$value": "{color.blue.600}",
          "$description": "Primary action background"
        },
        "bg-hover": {
          "$value": "{color.blue.700}"
        },
        "fg": {
          "$value": "{color.neutral.0}"
        },
        "text": {
          "$value": "{color.blue.600}",
          "$description": "Text and borders of ghost and outline actions"
        }
      },
      "danger": {
        "bg": {
          "$value": "{color.red.700}"
        },
        "bg-hover": {
          "$value": "{color.red.800}"
        },
        "fg": {
          "$value": "{color.neutral.0}"
        },
        "text": {
          "$value": "{color.red.700}"
        }
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.blue.600}",
        "$description": "Focus indicator"
      }
    }
  },
  "space": {
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "$type": "dimension",
    "$extensions": {
      "tessera": {
        "tier": "semantic"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "$extensions": {
      "tessera": {
        "tier": "semantic"
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Inter", "Segoe UI", "system-ui", "sans-serif"]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "bold": {
        "$value": "bold"
      }
    },
    "$extensions": {
      "tessera": {
        "tier": "semantic"
      }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": {
      "$value": 0.4
    },
    "$extensions": {
      "tessera": {
        "tier": "semantic"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1]
      }
    },
    "$extensions": {
      "tessera": {
        "tier": "semantic"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "md": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.2
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 4,
          "unit": "px"
        },
        "blur": {
          "value": 12,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "$extensions": {
      "tessera": {
        "tier": "semantic"
      }
    }
  }
}
