{
  "$extends": "base",
  "$auto": "prefers-color-scheme: dark",
  "color": {
    "surface": {
      "default": {
        "$value": "{color.neutral.900}"
      },
      "raised": {
        "$value": "{color.neutral.800}"
      },
      "hover": {
        "$value": "{color.neutral.700}"
      }
    },
    "text": {
      "default": {
        "$value": "{color.neutral.0}"
      },
      "muted": {
        "$value": "{color.neutral.100}"
      }
    },
    "action": {
      "primary": {
        "bg": {
          "$value": "{color.blue.400}"
        },
        "bg-hover": {
          "$value": "{color.blue.300}"
        },
        "fg": {
          "$value": "{color.neutral.900}"
        },
        "text": {
          "$value": "{color.blue.400}"
        }
      },
      "danger": {
        "text": {
          "$value": "{color.red.400}"
        }
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.blue.400}"
      }
    }
  }
}
