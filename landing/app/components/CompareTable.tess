            <tr each="row in g.rows" key="row.feature">
              <th class="feature" scope="row">
                <span class="name">{row.feature}</span>
                <span class="note" if="row.note">{row.note}</span>
              </th>
              <td class="cell" each="f in FRAMEWORKS" key="f.id" :data-lead="f.id === 'tessera' ? 'true' : 'false'">
                <StatusMark :status="row.cells[f.id].status" :label="STATUS_LABEL[row.cells[f.id].status]" />
                <span class="text">{row.cells[f.id].text}</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="cards">
        <section class="cardGroup" each="g in GROUPS" key="g.title">
