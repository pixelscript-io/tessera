    "entryValue"
  ]
}
</contract>

<script>
import { FRAMEWORKS, GROUPS, STATUS_LABEL, STATUS_MEANING } from '../data/compare'
</script>

<template>
  <section class="root" id="table">
    <div class="inner">
      <ul class="legend" aria-label="Key to the marks">
        <li class="legendItem" each="m in STATUS_MEANING" key="m.status">
          <StatusMark :status="m.status" :label="STATUS_LABEL[m.status]" />
          <span class="meaning">{m.meaning}</span>
        </li>
      </ul>

      <div class="scroll">
        <table class="table">
          <caption class="caption">
            Features of Tessera, React, Vue and Svelte compared
          </caption>
          <thead>
            <tr>
              <th class="corner" scope="col">Feature</th>
              <th class="framework" scope="col" each="f in FRAMEWORKS" key="f.id" :data-lead="f.id === 'tessera' ? 'true' : 'false'">{f.name}</th>
            </tr>
          </thead>
          <tbody each="g in GROUPS" key="g.title">
            <tr>
              <th class="group" scope="colgroup" colspan="5">{g.title}</th>
