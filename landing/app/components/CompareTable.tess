<contract>
{
  "name": "CompareTable",
  "role": "generic",
  "description": "The comparison: a key to the marks, then every feature against Tessera, React, Vue and Svelte. A table on a wide screen, a card for each feature on a phone.",
  "parts": [
    "root",
    "inner",
    "legend",
    "legendItem",
    "meaning",
    "scroll",
    "table",
