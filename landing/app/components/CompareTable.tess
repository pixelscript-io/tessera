          <article class="card" each="row in g.rows" key="row.feature">
            <h3 class="cardTitle">{row.feature}</h3>
            <p class="cardNote" if="row.note">{row.note}</p>
            <dl class="entries">
              <div class="entry" each="f in FRAMEWORKS" key="f.id" :data-lead="f.id === 'tessera' ? 'true' : 'false'">
                <dt class="entryName">{f.name}</dt>
                <dd class="entryValue">
                  <StatusMark :status="row.cells[f.id].status" :label="STATUS_LABEL[row.cells[f.id].status]" />
                  <span class="text">{row.cells[f.id].text}</span>
