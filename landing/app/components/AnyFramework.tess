<contract>
{
  "name": "AnyFramework",
  "role": "generic",
  "description": "The section for teams that do not write .tess: the linter and the custom elements, and two commands that help anywhere.",
  "parts": [
    "root",
    "inner",
    "cards",
    "how",
    "steps",
    "stepsTitle",
    "stepsBody",
    "stepsCommand",
    "notes",
    "note",
    "command"
  ],
  "contrast": [{ "foreground": "note", "background": "root" }]
}
</contract>

<script>
import { ELEMENTS, LINT } from '../data/examples'
import { FRAMEWORK_PANES, FRAMEWORK_TABS } from '../data/frameworks'
</script>

<template>
  <section class="root" id="anywhere">
    <div class="inner">
      <SectionHeader>
        <span slot="eyebrow">Outside .tess</span>
        <span slot="title">The same system in any framework.</span>
        Not every team will write .tess files. Two commands bring the system to a project that does not: one checks its CSS
        against your tokens, the other builds your components as custom elements that any framework can use.
      </SectionHeader>
      <div class="cards">
        <ExampleCard :label="LINT.label" :title="LINT.title" :body="LINT.body" :lines="LINT.lines" />
        <ExampleCard :label="ELEMENTS.label" :title="ELEMENTS.title" :body="ELEMENTS.body" :lines="ELEMENTS.lines" />
      </div>
      <div class="how">
        <div class="steps">
          <span class="stepsTitle">Using the elements in your framework</span>
          <p class="stepsBody">
            Build them once in your design system's project, then load the folder in the app. They are plain HTML tags (React also gets wrappers),
            so each framework only needs to be told those tags are not its own.
          </p>
          <div class="stepsCommand" tabindex="0">$ npx tessera elements</div>
        </div>
        <CodeTabs :tabs="FRAMEWORK_TABS" :panes="FRAMEWORK_PANES" label="Use the elements in your framework" name="frameworks" />
      </div>
      <div class="notes">
        <span class="note"><span class="command">tessera build --prerender</span> writes static HTML for pages.</span>
        <span class="note"><span class="command">tessera a11y</span> puts the generated accessibility tests in your project.</span>
      </div>
    </div>
  </section>
</template>

