.root {
  border-top: 1px solid $color.border.default;
  background: $color.surface.default;
}

.inner {
  display: flex;
  flex-direction: column;
  gap: $space.32;
  max-width: 1080px;
  margin: 0 auto;
  padding: $space.80 $space.24;
