{
  "$description": "Shadows (none here), motion and opacity. Example: replace shadow.md with a real shadow to lift cards off the page.",
  "shadow": {
    "$type": "shadow",
    "$extensions": {
      "tessera": {
        "tier": "semantic"
      }
    },
    "sm": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ]
    },
    "md": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ]
    }
  },
  "motion": {
    "$extensions": {
      "tessera": {
        "tier": "semantic"
      }
    },
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 150,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 300,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "in-out": {
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      }
    }
  },
  "opacity": {
    "$type": "number",
    "$extensions": {
      "tessera": {
        "tier": "semantic"
      }
    },
    "disabled": {
      "$value": 0.5
    }
  }
}
