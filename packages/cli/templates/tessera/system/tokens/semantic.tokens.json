{
  "$description": "What components use: surface, text, border, action, status and focus colors (light).",
  "color": {
    "$extensions": {
      "tessera": {
        "tier": "semantic"
      }
    },
    "$type": "color",
    "surface": {
      "default": {
        "$value": "{color.stone.50}"
      },
      "raised": {
        "$value": "{color.stone.100}"
      },
      "hover": {
        "$value": "{color.stone.200}"
      },
      "inverse": {
        "$value": "{color.stone.950}"
      }
    },
    "text": {
      "default": {
        "$value": "{color.stone.950}"
      },
      "muted": {
        "$value": "{color.stone.600}"
      },
      "inverse": {
        "$value": "{color.stone.50}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.stone.300}"
      },
      "strong": {
        "$value": "{color.stone.500}"
      }
    },
    "action": {
      "primary": {
        "bg": {
          "$value": "{color.stone.950}"
        },
        "bg-hover": {
          "$value": "{color.stone.700}"
        },
        "fg": {
          "$value": "{color.stone.50}"
        },
        "text": {
          "$value": "{color.stone.950}"
        }
      },
      "danger": {
        "bg": {
          "$value": "{color.red.700}"
        },
        "bg-hover": {
          "$value": "{color.red.800}"
        },
        "fg": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.red.700}"
        }
      }
    },
    "accent": {
      "default": {
        "$value": "{color.green.600}"
      },
      "soft": {
        "$value": "{color.green.100}"
      },
      "text": {
        "$value": "{color.green.700}"
      }
    },
    "status": {
      "success": {
        "$value": "{color.green.700}"
      },
      "danger": {
        "$value": "{color.red.700}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.stone.950}"
      }
    }
  }
}
