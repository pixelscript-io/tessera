<script>
import { setTheme } from '@pixelscriptio/tessera/tokens'

const light = () => setTheme(null)
const dark = () => setTheme('dark')
const auto = () => setTheme('auto')
</script>

<template>
  <div class="root">
    <header class="header">
      <p class="brand">My Tessera app</p>
      <div class="theme" role="group" aria-label="Theme">
        <Button tone="neutral" emphasis="ghost" size="sm" @press="light">Light</Button>
        <Button tone="neutral" emphasis="ghost" size="sm" @press="dark">Dark</Button>
        <Button tone="neutral" emphasis="ghost" size="sm" @press="auto">Auto</Button>
      </div>
    </header>
    <slot />
  </div>
</template>

