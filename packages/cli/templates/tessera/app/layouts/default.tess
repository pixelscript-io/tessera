          <Button tone="neutral" emphasis="ghost" size="sm" @press="light">Light</Button>
          <Button tone="neutral" emphasis="ghost" size="sm" @press="dark">Dark</Button>
          <Button tone="neutral" emphasis="ghost" size="sm" @press="auto">Auto</Button>
        </div>
      </nav>
    </header>
    <slot />
  </div>
</template>

