{
  "$comment": "An example of design tokens, in the W3C DTCG format. To use it, rename this file to base.tokens.json: any file named *.tokens.json in this folder is read. JSON has no comments, which is why this example is an inert .example file.",

  "color": {
    "$type": "color",
    "$extensions": { "tessera": { "tier": "primitive" } },
    "$comment": "Primitives are raw palette values. Components should not use them directly.",
    "blue": {
      "600": { "$value": { "colorSpace": "srgb", "components": [0.145, 0.388, 0.922] } }
    },
    "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } },
    "slate": {
      "900": { "$value": { "colorSpace": "srgb", "components": [0.059, 0.09, 0.165] } }
    }
  },

  "semantic": {
    "$comment": "Semantic tokens give a primitive a meaning. Components use these, and themes override them. They live under 'color' so styles can write $color.surface.default.",
    "$ignore": true
  },

  "space": {
    "$type": "dimension",
    "$extensions": { "tessera": { "tier": "semantic" } },
    "$comment": "A spacing scale. In a style: padding: $space.4;",
    "2": { "$value": { "value": 8, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } }
  }
}
