{
  "name": "@tessera/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "tessera": "./bin/tessera.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "generate:tailwind": "vite-node scripts/generate-tailwind.ts",
    "build:registry": "vite-node scripts/build-registry.ts",
    "build:ui-site": "vite-node scripts/build-site.ts"
  },
  "dependencies": {
    "@tessera/agent": "workspace:*",
    "@tessera/compiler": "workspace:*",
    "@tessera/docs": "workspace:*",
    "@tessera/editor": "workspace:*",
    "@tessera/contract": "workspace:*",
    "@tessera/router": "workspace:*",
    "@tessera/tokens": "workspace:*",
    "acorn": "^8.14.0"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "vite-node": "^3.2.4"
  }
}
