{
  "name": "@pixelscriptio/tessera",
  "version": "0.2.1",
  "description": "A design-system-first frontend framework: tokens, accessibility, variants and docs built in and enforced at compile time.",
  "type": "module",
  "bin": {
    "tessera": "./bin/tessera.js"
  },
  "exports": {
    "./core": "./src/core.ts",
    "./router": "./src/router.ts",
    "./router/app": "./src/router-app.ts",
    "./behavior": "./src/behavior.ts",
    "./tokens": "./src/tokens.ts",
    "./vite": "./src/vite.ts",
    "./cli": "./src/cli.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./core": {
        "types": "./dist/types/packages/tessera/src/core.d.ts",
        "default": "./dist/core.js"
      },
      "./router": {
        "types": "./dist/types/packages/tessera/src/router.d.ts",
        "default": "./dist/router.js"
      },
      "./router/app": {
        "types": "./dist/types/packages/tessera/src/router-app.d.ts",
        "default": "./dist/router-app.js"
      },
      "./behavior": {
        "types": "./dist/types/packages/tessera/src/behavior.d.ts",
        "default": "./dist/behavior.js"
      },
      "./tokens": {
        "types": "./dist/types/packages/tessera/src/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "./vite": {
        "types": "./dist/types/packages/tessera/src/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./cli": {
        "types": "./dist/types/packages/tessera/src/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && node scripts/types.mjs && node scripts/components.mjs"
  },
  "dependencies": {
    "acorn": "^8.14.0",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
