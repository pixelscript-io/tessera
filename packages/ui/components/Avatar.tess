<contract>
{
  "name": "Avatar",
  "role": "img",
  "description": "A person or a thing as a picture, or as initials when there is no picture or it does not load.",
  "since": "0.8.0",
  "parts": ["root", "image", "initials"],
  "variants": {
    "size": ["md", "sm", "lg"] // first value is the default
  },
  "preview": {
    "props": {
      "name": "Ada Lovelace"
    }
  }
}
</contract>

<script>
const { src, name } = props({ src: '', name: '' })

// A picture that fails to load falls back to the initials.
const failed = state(false)
effect(() => {
  src.value
  failed.value = false
})

function broke() {
  failed.value = true
}

const initials = derived(() =>
  name.value
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0].toUpperCase())
    .join(''),
)
</script>

<template>
  <span class="root" role="img" :aria-label="name || 'Avatar'">
    <img
      class="image"
      if="src && !failed"
      :src="src"
      alt=""
      @error="broke()"
      />
    <span class="initials" else aria-hidden="true">{initials}</span>
  </span>
</template>

<style>
.root {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: $space.8;
  height: $space.8;
  overflow: hidden;
  border-radius: $radius.full;
  background: $color.surface.hover;
  color: $color.text.default;
  font-size: $font.size.sm;
  font-weight: $font.weight.bold;

  &[data-size='sm'] {
    width: $space.6;
    height: $space.6;
    font-size: $font.size.xs;
  }

  &[data-size='lg'] {
    width: $space.12;
    height: $space.12;
    font-size: $font.size.lg;
  }
}

.image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
</style>
