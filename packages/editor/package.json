{
  "name": "@tessera/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./prettier": {
      "types": "./src/prettier-plugin.ts",
      "default": "./dist/prettier-plugin.js"
    }
  },
  "scripts": {
    "build": "vite build && vite build -c vite.prettier.config.ts"
  },
  "dependencies": {
    "@tessera/compiler": "workspace:*",
    "@tessera/contract": "workspace:*",
    "@tessera/tokens": "workspace:*"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  }
}
